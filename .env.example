# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GEMINI_BASE_URL: The secure API endpoint or Cloudflare workers proxy.
# Do not code your actual URL here if you push to public GitHub.
GEMINI_BASE_URL=https://your-cloudflare-worker-url.workers.dev/

# WORKER_SECRET_KEY: This app now uses Firebase Authentication Google Sign-In 
# ID Tokens to verify requests to Cloudflare Worker, which is more secure. 
# Static secrets are no longer used.

# TYPELLM_API_KEY: Opsional. Engine OCR struk memakai TypeLLM (https://typellm.ai)
# HANYA JIKA key ini terisi. Kosongkan untuk memakai Gemini lewat Worker (default).
# Format key: tl-sk-...
# CATATAN KEAMANAN: key ini di-build ke dalam BuildConfig sehingga bisa diekstrak
# dari APK. Untuk produksi, kosongkan dan arahkan TYPELLM_BASE_URL ke proxy sendiri.
TYPELLM_API_KEY=TYPELLM_KEY_NOT_CONFIGURED

# TYPELLM_BASE_URL: Endpoint TypeLLM. Default: https://api.typellm.ai
# Bisa diarahkan ke Cloudflare Worker milik sendiri agar key tidak masuk APK.
TYPELLM_BASE_URL=https://api.typellm.ai
